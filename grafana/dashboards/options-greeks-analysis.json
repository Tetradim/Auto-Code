{
  "title": "Options Greeks Analysis",
  "uid": "sentinel-greeks",
  "tags": ["sentinel", "options", "greeks", "delta", "theta", "vega", "gamma"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "templating": {
    "list": [
      { "name": "symbol", "type": "query", "datasource": "Prometheus", "query": "label_values(gex_net, symbol)", "multi": true, "includeAll": true },
      { "name": "timeframe", "type": "custom", "query": "5m,15m,30m,1h,4h,1d", "current": { "text": "1h", "value": "1h" } }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Delta (Direction & Probability)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "delta_net{symbol=~\"$symbol\"}", "legendFormat": "Net Delta" },
        { "refId": "B", "expr": "delta_total_call{symbol=~\"$symbol\"}", "legendFormat": "Call Delta" },
        { "refId": "C", "expr": "delta_total_put{symbol=~\"$symbol\"}", "legendFormat": "Put Delta" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currency",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Net Delta",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "delta_net{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area", "orientation": "auto" }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Delta Direction",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "refId": "A", "expr": "delta_direction_strength{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ITM Probability",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "delta_prob_itm_call{symbol=~\"$symbol\"}", "legendFormat": "Call" },
        { "refId": "B", "expr": "delta_prob_itm_put{symbol=~\"$symbol\"}", "legendFormat": "Put" }
      ],
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Theta (Time Decay)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "theta_net{symbol=~\"$symbol\"}", "legendFormat": "Net Theta" },
        { "refId": "B", "expr": "theta_total_call{symbol=~\"$symbol\"}", "legendFormat": "Call Theta" },
        { "refId": "C", "expr": "theta_total_put{symbol=~\"$symbol\"}", "legendFormat": "Put Theta" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currency",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Daily Decay Cost",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
      "targets": [{ "refId": "A", "expr": "theta_daily_decay{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Theta Regime",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "targets": [{ "refId": "A", "expr": "theta_decay_rate{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Portfolio Drag",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "targets": [{ "refId": "A", "expr": "theta_drag{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Vega (Volatility Sensitivity)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "vex_net{symbol=~\"$symbol\"}", "legendFormat": "Net Vega" },
        { "refId": "B", "expr": "vex_total_call{symbol=~\"$symbol\"}", "legendFormat": "Call Vega" },
        { "refId": "C", "expr": "vex_total_put{symbol=~\"$symbol\"}", "legendFormat": "Put Vega" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currency",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Implied Volatility",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 16 },
      "targets": [{ "refId": "A", "expr": "vex_atm_iv{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "IV Skew",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 16 },
      "targets": [{ "refId": "A", "expr": "vex_iv_skew{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "options": { "colorMode": "background" }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Vol Regime",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 16 },
      "targets": [{ "refId": "A", "expr": "vex_sentiment_strength{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Gamma (Delta Acceleration)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "gamma_net{symbol=~\"$symbol\"}", "legendFormat": "Net Gamma" },
        { "refId": "B", "expr": "gamma_call{symbol=~\"$symbol\"}", "legendFormat": "Call Gamma" },
        { "refId": "C", "expr": "gamma_put{symbol=~\"$symbol\"}", "legendFormat": "Put Gamma" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currency",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "GEX (Gamma Exposure)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 24 },
      "targets": [{ "refId": "A", "expr": "gex_net{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 15,
      "type": "gauge",
      "title": "Gamma Risk",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 24 },
      "targets": [{ "refId": "A", "expr": "gamma_pnl_1pct{symbol=~\"$symbol\"}", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Moneyness Distribution",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "gamma_itm{symbol=~\"$symbol\"}", "legendFormat": "ITM" },
        { "refId": "B", "expr": "gamma_atm{symbol=~\"$symbol\"}", "legendFormat": "ATM" },
        { "refId": "C", "expr": "gamma_otm{symbol=~\"$symbol\"}", "legendFormat": "OTM" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "displayMode": "gradient_gauge",
            "orientation": "horizontal"
          }
        }
      }
    }
  ]
}