{
  "dashboard": {
    "title": "Market Coverage",
    "uid": "market-coverage",
    "tags": ["sentinel-edge", "markets"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "NYSE/NASDAQ",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [{
          "expr": "market_open_status{market=\"NYSE\"}",
          "refId": "A"
        }],
        "options": {
          "graphMode": "none",
          "colorMode": "background",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "🔴 CLOSED"},
              {"type": "value", "value": "1", "text": "🟢 OPEN"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
