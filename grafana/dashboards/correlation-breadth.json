{
  "title": "Sentinel Edge — Market Breadth & Correlation",
  "uid": "se-correlation-breadth",
  "tags": ["sentinel-edge", "correlation", "breadth"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "10s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Clusters",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(analyst_correlation_clusters_total)", "refId": "A"}],
      "options": {"graphMode": "area", "colorMode": "value"}
    },
    {
      "id": 2, "type": "stat", "title": "Bullish Clusters",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(analyst_correlation_clusters_total{direction=\"bullish\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"fixedColor": "green", "mode": "fixed"}}}
    },
    {
      "id": 3, "type": "stat", "title": "Bearish Clusters",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(analyst_correlation_clusters_total{direction=\"bearish\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"fixedColor": "red", "mode": "fixed"}}}
    },
    {
      "id": 4, "type": "stat", "title": "High-Strength Clusters",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(analyst_correlation_clusters_total{strength=\"high\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"fixedColor": "orange", "mode": "fixed"}}}
    },
    {
      "id": 10, "type": "table",
      "title": "Live Correlation Clusters",
      "description": "All direction/strength combinations with total counts",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "analyst_correlation_clusters_total", "refId": "A", "format": "table", "instant": true}
      ],
      "transformations": [
        {"id": "organize", "options": {"renameByName": {"direction": "Direction", "strength": "Strength", "Value": "Count"}}},
        {"id": "sortBy", "options": {"fields": [{"desc": true, "displayName": "Count"}]}}
      ],
      "fieldConfig": {
        "overrides": [
          {"matcher": {"id": "byName", "options": "Direction"}, "properties": [{"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "Strength"}, "properties": [{"id": "custom.width", "value": 100}]},
          {
            "matcher": {"id": "byName", "options": "Direction"},
            "properties": [{
              "id": "mappings",
              "value": [
                {"type": "value", "options": {"bullish": {"text": "▲ BULLISH", "color": "green"}}},
                {"type": "value", "options": {"bearish": {"text": "▼ BEARISH", "color": "red"}}}
              ]
            }]
          }
        ]
      }
    },
    {
      "id": 11, "type": "piechart",
      "title": "Bullish vs Bearish Clusters",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(analyst_correlation_clusters_total{direction=\"bullish\"})", "refId": "A", "legendFormat": "Bullish"},
        {"expr": "sum(analyst_correlation_clusters_total{direction=\"bearish\"})", "refId": "B", "legendFormat": "Bearish"}
      ],
      "options": {
        "pieType": "donut",
        "legend": {"displayMode": "table", "placement": "right"},
        "tooltip": {"mode": "single"}
      },
      "fieldConfig": {
        "overrides": [
          {"matcher": {"id": "byName", "options": "Bullish"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Bearish"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}
        ]
      }
    },
    {
      "id": 20, "type": "timeseries", "title": "Cluster Detection Rate",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [
        {"expr": "rate(analyst_correlation_clusters_total{direction=\"bullish\"}[5m])", "refId": "A", "legendFormat": "Bullish/s"},
        {"expr": "rate(analyst_correlation_clusters_total{direction=\"bearish\"}[5m])", "refId": "B", "legendFormat": "Bearish/s"}
      ],
      "fieldConfig": {
        "overrides": [
          {"matcher": {"id": "byName", "options": "Bullish/s"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Bearish/s"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 30, "type": "piechart", "title": "Strength Distribution",
      "gridPos": {"x": 0, "y": 20, "w": 8, "h": 7},
      "targets": [
        {"expr": "sum(analyst_correlation_clusters_total{strength=\"high\"})", "refId": "A", "legendFormat": "High (>70%)"},
        {"expr": "sum(analyst_correlation_clusters_total{strength=\"medium\"})", "refId": "B", "legendFormat": "Medium (≤70%)"}
      ],
      "options": {"pieType": "donut", "legend": {"displayMode": "table", "placement": "right"}}
    },
    {
      "id": 31, "type": "timeseries",
      "title": "Market Breadth — BUY vs STOP Rate",
      "description": "Rate of BUY vs STOP_BUYING decisions proxies live market directional bias",
      "gridPos": {"x": 8, "y": 20, "w": 16, "h": 7},
      "targets": [
        {"expr": "sum(rate(edge_decision_total{decision=\"buy\"}[2m]))", "refId": "A", "legendFormat": "BUY rate"},
        {"expr": "sum(rate(edge_decision_total{decision=\"stop_buying\"}[2m]))", "refId": "B", "legendFormat": "STOP rate"},
        {"expr": "sum(rate(edge_decision_total{decision=\"emergency_exit\"}[2m]))", "refId": "C", "legendFormat": "EXIT rate"},
        {"expr": "sum(rate(analyst_pulse_overrides_total[2m]))", "refId": "D", "legendFormat": "Pulse overrides/s"}
      ],
      "fieldConfig": {
        "overrides": [
          {"matcher": {"id": "byName", "options": "BUY rate"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "STOP rate"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "EXIT rate"}, "properties": [{"id": "color", "value": {"fixedColor": "dark-red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Pulse overrides/s"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}
        ]
      }
    }
  ]
}
