{
  "dashboard": {
    "title": "Broker Health",
    "uid": "broker-health",
    "tags": ["sentinel-edge", "broker"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Circuit Breaker State",
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
        "targets": [{
          "expr": "broker_circuit_state",
          "refId": "A",
          "legendFormat": "{{broker_id}}"
        }],
        "options": {
          "graphMode": "none",
          "colorMode": "background",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "CLOSED", "color": "green"},
              {"type": "value", "value": "1", "text": "HALF_OPEN", "color": "yellow"},
              {"type": "value", "value": "2", "text": "OPEN", "color": "red"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 2, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "type": "gauge",
        "title": "Failure Rate %",
        "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
        "targets": [{
          "expr": "broker_failure_rate",
          "refId": "A",
          "legendFormat": "{{broker_id}}"
        }],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 20, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Total API Calls",
        "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
        "targets": [{
          "expr": "sum(edge_api_calls_total)",
          "refId": "A"
        }],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        }
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "API Success vs Failure Rate",
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(edge_api_calls_total{status=\"success\"}[1m]))",
            "refId": "A",
            "legendFormat": "Success"
          },
          {
            "expr": "sum(rate(edge_api_calls_total{status=\"failure\"}[1m]))",
            "refId": "B",
            "legendFormat": "Failure"
          },
          {
            "expr": "sum(rate(edge_api_calls_total{status=\"timeout\"}[1m]))",
            "refId": "C",
            "legendFormat": "Timeout"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 30,
              "stacking": {"mode": "normal"}
            }
          },
          "overrides": [
            {"matcher": {"id": "byName", "options": "Failure"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
            {"matcher": {"id": "byName", "options": "Timeout"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
          ]
        }
      },
      {
        "id": 5,
        "type": "heatmap",
        "title": "API Latency Distribution",
        "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
        "targets": [{
          "expr": "sum(rate(edge_api_latency_seconds_bucket[5m])) by (le)",
          "refId": "A",
          "format": "heatmap"
        }]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "API Latency Percentiles",
        "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(edge_api_latency_seconds_bucket[5m])) by (le))",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(edge_api_latency_seconds_bucket[5m])) by (le))",
            "refId": "B",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(edge_api_latency_seconds_bucket[5m])) by (le))",
            "refId": "C",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "API Rate Limit Rejections",
        "description": "Edge API requests rejected by the in-memory rate limiter. Sustained non-zero values indicate client polling or automation pressure.",
        "gridPos": {"x": 0, "y": 22, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(edge_rate_limit_rejections_total{scope=\"api\"}[$__range]))",
            "refId": "A",
            "legendFormat": "Selected range total"
          },
          {
            "expr": "edge_rate_limit_rejections:rate5m{scope=\"api\"}",
            "refId": "B",
            "legendFormat": "5m rate/sec"
          }
        ],
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "single"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 2,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "API Rate Limiter State",
        "description": "Aggregate state for the in-memory API rate limiter. Tracks bucket growth without exposing client identifiers.",
        "gridPos": {"x": 0, "y": 30, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "edge_rate_limit_tracked_clients",
            "refId": "A",
            "legendFormat": "Tracked client buckets"
          },
          {
            "expr": "increase(edge_rate_limit_pruned_clients_total[$__range])",
            "refId": "B",
            "legendFormat": "Pruned buckets in range"
          }
        ],
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "single"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 100, "color": "yellow"},
                {"value": 500, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "type": "timeseries",
        "title": "Pulse API SLO Burn Rate",
        "description": "99% availability SLO burn rate for Pulse API calls. Alert thresholds watch paired short and long windows to reduce noise while catching fast dependency failures.",
        "gridPos": {"x": 0, "y": 38, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "edge_api_availability:burn_rate5m",
            "refId": "A",
            "legendFormat": "5m burn"
          },
          {
            "expr": "edge_api_availability:burn_rate30m",
            "refId": "B",
            "legendFormat": "30m burn"
          },
          {
            "expr": "edge_api_availability:burn_rate1h",
            "refId": "C",
            "legendFormat": "1h burn"
          },
          {
            "expr": "edge_api_availability:burn_rate6h",
            "refId": "D",
            "legendFormat": "6h burn"
          }
        ],
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "multi"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 2,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 6, "color": "yellow"},
                {"value": 14.4, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "type": "state-timeline",
        "title": "Edge Readiness Checks",
        "description": "Overall Edge readiness and each fixed dependency check from /api/ready. Use this with the EdgeRuntimeNotReady alert to quickly identify the failing startup/runtime dependency.",
        "gridPos": {"x": 0, "y": 46, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "edge_readiness_status",
            "refId": "A",
            "legendFormat": "runtime"
          },
          {
            "expr": "edge_readiness_check_status",
            "refId": "B",
            "legendFormat": "{{check}}"
          }
        ],
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "multi"},
          "mergeValues": true,
          "showValue": "always"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "mappings": [
              {"type": "value", "value": "0", "text": "NOT READY", "color": "red"},
              {"type": "value", "value": "1", "text": "READY", "color": "green"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "Automation Handoff Outcomes",
        "description": "Tracks sent, failed, and suppressed Edge-to-Pulse handoff outcomes by bounded result and reason labels. Use this to confirm whether automation is blocked by market hours, confidence, cooldown, readiness, or Pulse delivery.",
        "gridPos": {"x": 0, "y": 54, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "edge_automation_handoffs:rate5m",
            "refId": "A",
            "legendFormat": "{{result}} / {{reason}}"
          },
          {
            "expr": "sum by (result, reason) (increase(edge_automation_handoffs_total[$__range]))",
            "refId": "B",
            "legendFormat": "{{result}} / {{reason}} total"
          }
        ],
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "multi"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 3,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 15,
              "stacking": {"mode": "normal"}
            },
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.1, "color": "yellow"},
                {"value": 1, "color": "red"}
              ]
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byRegexp", "options": "failed.*|suppressed.*"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": "sent.*"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
            }
          ]
        }
      }
    ]
  }
}
